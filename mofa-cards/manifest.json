{
  "name": "mofa-cards",
  "version": "0.1.0",
  "timeout_secs": 1800,
  "binaries": {
    "darwin-aarch64": {
      "url": "https://github.com/mofa-org/mofa-skills/releases/download/v0.3.1/mofa-darwin-aarch64.tar.gz",
      "sha256": "2b2e48b7e3153046d92f4112af82dbd7f7fbd6bcd3ab9fc60d0a0e51192a2e00"
    }
  },
  "tools": [
    {
      "name": "mofa_cards",
      "description": "Generate AI-powered greeting cards and holiday cards as PNG images.",
      "input_schema": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "description": "Array of card objects",
            "items": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string",
                  "description": "Card content description"
                },
                "style": {
                  "type": "string",
                  "description": "Card variant"
                }
              },
              "required": [
                "prompt"
              ]
            }
          },
          "style": {
            "type": "string",
            "description": "Style template name (default: cny-guochao)",
            "default": "cny-guochao"
          },
          "card_dir": {
            "type": "string",
            "description": "Output directory for card PNGs"
          },
          "aspect": {
            "type": "string",
            "description": "Aspect ratio"
          },
          "concurrency": {
            "type": "integer",
            "description": "Parallel generation limit (default: 5)"
          },
          "image_size": {
            "type": "string",
            "description": "Image size: 1K, 2K, 4K"
          },
          "api": {
            "type": "string",
            "description": "API mode: rt (realtime, fast) or batch (50% cheaper, async)",
            "default": "rt",
            "enum": [
              "rt",
              "batch"
            ]
          }
        },
        "required": [
          "cards",
          "card_dir"
        ]
      }
    }
  ]
}

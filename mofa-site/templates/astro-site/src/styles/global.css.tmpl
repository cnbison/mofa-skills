:root {
  --bg: #f4efe5;
  --surface: rgba(255, 255, 255, 0.75);
  --surface-strong: #fffaf0;
  --text: #1d1b17;
  --muted: #5f5a52;
  --border: rgba(29, 27, 23, 0.12);
  --accent: {{accent_hex}};
  --accent-soft: color-mix(in srgb, {{accent_hex}} 16%, white);
  --shadow: 0 18px 40px rgba(41, 28, 12, 0.08);
  --radius: 22px;
  --shell: min(1120px, calc(100vw - 48px));
  --font-sans: "Manrope", "Inter", system-ui, sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.88), transparent 32rem),
    linear-gradient(180deg, #f7f3eb 0%, #efe7da 100%);
  color: var(--text);
  font-family: var(--font-sans);
}

a {
  color: inherit;
  text-decoration: none;
}

.shell {
  width: var(--shell);
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  backdrop-filter: blur(18px);
  background: rgba(244, 239, 229, 0.86);
  border-bottom: 1px solid var(--border);
  z-index: 10;
}

.header-row,
.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 0;
}

.brand {
  font-weight: 800;
  letter-spacing: -0.03em;
}

.site-nav {
  display: flex;
  gap: 18px;
  color: var(--muted);
}

.hero,
.prose-block,
.feature-section {
  padding: 72px 0 24px;
}

.eyebrow {
  display: inline-flex;
  margin: 0 0 16px;
  padding: 8px 12px;
  background: var(--accent-soft);
  border: 1px solid color-mix(in srgb, var(--accent) 25%, white);
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--accent) 74%, black);
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1,
h2 {
  letter-spacing: -0.05em;
}

h1 {
  font-size: clamp(3rem, 7vw, 5.4rem);
  max-width: 12ch;
}

h2 {
  font-size: clamp(2rem, 4vw, 3.4rem);
}

.lede,
.prose-block p:last-child {
  margin-top: 20px;
  max-width: 62ch;
  font-size: 1.08rem;
  line-height: 1.75;
  color: var(--muted);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 20px;
  border-radius: 999px;
  border: 1px solid transparent;
  font-weight: 700;
}

.button-primary {
  background: var(--accent);
  color: white;
  box-shadow: var(--shadow);
}

.button-secondary {
  background: rgba(255, 255, 255, 0.7);
  border-color: var(--border);
}

.section-heading {
  display: grid;
  gap: 12px;
  margin-bottom: 24px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.feature-card {
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.feature-card p {
  margin-top: 12px;
  line-height: 1.7;
  color: var(--muted);
}

.site-footer {
  margin-top: 72px;
  border-top: 1px solid var(--border);
  color: var(--muted);
}

@media (max-width: 860px) {
  .header-row,
  .footer-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .site-nav,
  .hero-actions,
  .feature-grid {
    width: 100%;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }
}

:root {
  --bg: #eef2f7;
  --panel: rgba(255, 255, 255, 0.78);
  --panel-strong: #ffffff;
  --text: #1e293b;
  --muted: #5f6f86;
  --border: rgba(30, 41, 59, 0.12);
  --accent: {{accent_hex}};
  --accent-strong: color-mix(in srgb, var(--accent) 72%, #0f172a);
  --radius: 28px;
  --shell: min(1120px, calc(100vw - 48px));
  --shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
  --font-sans: "Space Grotesk", "Avenir Next", "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  background:
    radial-gradient(circle at top left, color-mix(in srgb, var(--accent) 20%, white), transparent 24rem),
    linear-gradient(180deg, #f7fafc 0%, #eef3f8 100%);
  color: var(--text);
  font-family: var(--font-sans);
}

body {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

.shell {
  width: var(--shell);
  margin: 0 auto;
}

.page-stack {
  padding-bottom: 88px;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
  background: rgba(247, 250, 252, 0.86);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 0;
}

.brand {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.nav {
  display: flex;
  gap: 16px;
  color: var(--muted);
}

.nav a {
  padding-bottom: 2px;
  border-bottom: 1px solid transparent;
}

.nav a:hover {
  border-color: currentColor;
}

.hero-band,
.section-band {
  padding: 48px 0 0;
}

.hero,
.feature-grid {
  margin-top: 32px;
}

.hero {
  padding: 64px 56px;
  border-radius: 36px;
  border: 1px solid var(--border);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.88), color-mix(in srgb, var(--accent) 8%, white)),
    var(--panel);
  box-shadow: var(--shadow);
}

.eyebrow {
  display: inline-flex;
  margin: 0 0 16px;
  padding: 8px 12px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 15%, white);
  color: var(--accent-strong);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p {
  margin: 0;
}

h1 {
  font-size: clamp(3rem, 7vw, 5.2rem);
  letter-spacing: -0.06em;
  max-width: 12ch;
}

h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.05em;
}

.lede,
.section-copy p:last-child,
.prose-shell p:last-child {
  margin-top: 20px;
  max-width: 60ch;
  line-height: 1.75;
  color: var(--muted);
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 999px;
  border: 1px solid var(--border);
  font-weight: 700;
}

.button-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: white;
}

.button-secondary {
  background: rgba(255, 255, 255, 0.6);
}

.section-copy,
.prose-shell {
  padding: 32px 0 8px;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.feature-card {
  padding: 24px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--panel-strong);
  box-shadow: var(--shadow);
}

.feature-card p {
  margin-top: 12px;
  line-height: 1.7;
  color: var(--muted);
}

.site-footer {
  margin-top: 64px;
  border-top: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.64);
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 26px 0 40px;
  color: var(--muted);
}

.footer-row p {
  max-width: 54ch;
}

@media (max-width: 860px) {
  .header-row,
  .nav,
  .button-row,
  .footer-row {
    flex-wrap: wrap;
  }

  .hero {
    padding: 32px 24px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }
}

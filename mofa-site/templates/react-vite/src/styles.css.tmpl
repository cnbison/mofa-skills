:root {
  --bg: #f3f1ec;
  --surface: rgba(255, 255, 255, 0.72);
  --surface-strong: #fffdf8;
  --text: #201d18;
  --muted: #5f594f;
  --border: rgba(32, 29, 24, 0.12);
  --accent: {{accent_hex}};
  --radius: 22px;
  --shadow: 0 22px 48px rgba(56, 39, 16, 0.08);
  --shell: min(1120px, calc(100vw - 48px));
  --font-sans: "Inter", system-ui, sans-serif;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
}

body {
  background:
    radial-gradient(circle at top right, rgba(255, 255, 255, 0.9), transparent 28rem),
    linear-gradient(180deg, #f7f4ed 0%, #eee5d6 100%);
  color: var(--text);
  font-family: var(--font-sans);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

.shell {
  width: var(--shell);
  margin: 0 auto;
}

.page-stack {
  padding-bottom: 80px;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(16px);
  background: rgba(247, 244, 237, 0.84);
  border-bottom: 1px solid var(--border);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 0;
}

.brand {
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}

.nav {
  display: flex;
  gap: 16px;
  color: var(--muted);
}

.hero,
.feature-grid {
  margin-top: 48px;
}

.hero {
  padding: 52px;
  border-radius: 32px;
  border: 1px solid var(--border);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.eyebrow {
  display: inline-flex;
  margin: 0 0 16px;
  padding: 8px 12px;
  border-radius: 999px;
  background: color-mix(in srgb, var(--accent) 15%, white);
  color: color-mix(in srgb, var(--accent) 72%, black);
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1,
h3,
p {
  margin: 0;
}

h1 {
  font-size: clamp(3rem, 7vw, 5rem);
  letter-spacing: -0.06em;
  max-width: 12ch;
}

.lede {
  margin-top: 20px;
  max-width: 58ch;
  line-height: 1.75;
  color: var(--muted);
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 28px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 999px;
  border: 1px solid transparent;
  cursor: pointer;
}

.button-primary {
  background: var(--accent);
  color: white;
  box-shadow: var(--shadow);
}

.button-secondary {
  border-color: var(--border);
  background: rgba(255, 255, 255, 0.65);
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.feature-card {
  padding: 24px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--surface-strong);
  box-shadow: var(--shadow);
}

.feature-card p {
  margin-top: 12px;
  line-height: 1.7;
  color: var(--muted);
}

@media (max-width: 860px) {
  .header-row,
  .nav,
  .button-row {
    flex-wrap: wrap;
  }

  .hero {
    padding: 32px 24px;
  }

  .feature-grid {
    grid-template-columns: 1fr;
  }
}
